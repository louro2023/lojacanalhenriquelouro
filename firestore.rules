rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // User accounts with download credits & licenses
    match /userAccounts/{userId} {
      allow read, write: if true;
    }

    // Games catalog with real-time stats
    match /games/{gameId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // System & license settings
    match /systemSettings/{settingId} {
      allow read, write: if true;
    }

    // Community messages
    match /supporterMessages/{messageId} {
      allow read: if true;
      allow create: if request.resource.data.name is string &&
                    request.resource.data.name.size() > 0 &&
                    request.resource.data.name.size() <= 60 &&
                    request.resource.data.message is string &&
                    request.resource.data.message.size() > 0 &&
                    request.resource.data.message.size() <= 300;
      allow update, delete: if false;
    }

    // Community Game Requests with Thumbs-up / Curtidas Voting & Ranking
    match /gameRequests/{requestId} {
      allow read: if true;
      allow create: if request.resource.data.gameTitle is string &&
                    request.resource.data.gameTitle.size() > 0 &&
                    request.resource.data.gameTitle.size() <= 100 &&
                    request.resource.data.userName is string &&
                    request.resource.data.userName.size() > 0 &&
                    request.resource.data.userName.size() <= 60 &&
                    request.resource.data.likes is int &&
                    request.resource.data.likes >= 0;
      allow update: if request.resource.data.likes is int &&
                    request.resource.data.likes >= 0 &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']);
      allow delete: if false;
    }
  }
}
